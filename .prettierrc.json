{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "none",
  "arrowParens": "avoid",
  "singleAttributePerLine": false,
  "tailwindFunctions": ["cva", "cx", "clsx", "twMerge"],
  "plugins": ["prettier-plugin-tailwindcss"]
}
